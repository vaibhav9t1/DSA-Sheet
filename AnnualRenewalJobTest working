    @Test
    void incrementsRetryCountAndMarksFailedWhenMaxRetriesExceeded() {
      // given
      JobConfig config = createJobConfig();
      config.getPeriodicQueueProcessingJobTypeConfig().setMaxRetries(3);

      JobInstanceEntity jobInstance = createJobInstance(
          JobInstanceStatus.IN_PROGRESS, LocalDateTime.now());

      // 1 failing queue record with retryCount = 2 (one before max)
      QueueRecordEntity record = createQueueRecord(2000L, QueueRecordStatus.PENDING, 2);

      record.setContextData(new HashMap<>() {{
        put("accountNumber", DEFAULT_ACCOUNT_NUMBER);
        put("didNumberId", DEFAULT_DID_NUMBER_ID);
        put("itemCode", DEFAULT_ITEM_CODE);
        put("renewalDate", TODAY.plusDays(30));
      }});

      // Force mapper to build context DTO
      when(periodicMapper.mapToQueueRecordContextData(any(), any()))
          .thenReturn(new AnnualRenewalQueueRecordContextDto());

      when(periodicMapper.mapToJobInstContextData(any(), any()))
          .thenReturn(createContextData());

      // Force processQueueRecord() to throw → triggers incRetryCountOrMarkQueueRecordFailed
      Mockito.doThrow(new RuntimeException("Forced failure"))
          .when(annualRenewalMapper).mapEmailPlaceholderToPayloadDto(any());

      // When saving record after retry/failed, just return it
      when(queueRecordRepository.save(any())).thenAnswer(inv -> inv.getArgument(0));

      when(queueRecordRepository.findByJobInstanceIdAndStatus(
          eq(1L), eq(QueueRecordStatus.PENDING), any()))
          .thenReturn(List.of(record))
          .thenReturn(List.of());  // next iteration stops the job

      // when
      annualRenewalJob.runJobInstance(jobInstance, config);

      // then — retryCount was 2, so on failure → retryCount=3 == max → mark FAILED
      assertThat(record.getRetryCount()).isEqualTo(3);
      assertThat(record.getStatus()).isEqualTo(QueueRecordStatus.FAILED);

      verify(queueRecordRepository, atLeastOnce()).save(record);
    }


  }

  @Nested
  class JobRecoveryAndStaleness {

    private static Stream<Arguments> stalenessScenarios() {
      return Stream.of(
          Arguments.of(LocalDateTime.now().minusDays(1), false),
          Arguments.of(LocalDateTime.now().minusDays(LOOKBACK_DAYS + 1), true),
          Arguments.of(LocalDateTime.now().minusDays(LOOKBACK_DAYS), false),
          Arguments.of(LocalDateTime.now(), false));
    }

    @ParameterizedTest
    @MethodSource("stalenessScenarios")
    void determinesJobStalenessBasedOnLookbackWindow(
        LocalDateTime jobCreateDate, boolean expectedStale) {
      AnnualRenewalJobContextDataDto contextData = createContextData();

      boolean isStale =
          annualRenewalJob.isRecoveredJobInstStale(
              1L, buildBusinessIdentifier(TODAY), jobCreateDate, contextData);

      assertThat(isStale).isEqualTo(expectedStale);
    }

    @Test
    void recoversNonStaleJobAndContinuesProcessing() {
      JobConfig config = createJobConfig();
      JobInstanceEntity jobInstance =
          createJobInstance(JobInstanceStatus.IN_PROGRESS, LocalDateTime.now().minusDays(1));

      when(queueRecordRepository.updateStatusByJobInstanceIdAndStatus(anyLong(), any(), any()))
          .thenReturn(0);

      JobInstanceEntity result = annualRenewalJob.onJobInstanceRecovery(jobInstance, config);

      assertThat(result.getStatus()).isEqualTo(JobInstanceStatus.IN_PROGRESS);
      verify(queueRecordRepository, never())
          .updateStatusByJobInstanceIdAndStatus(anyLong(), any(), any());
    }

    @Test
    void recoversStaleJobAndSkipsPendingRecords() {
      JobConfig config = createJobConfig();
      JobInstanceEntity jobInstance =
          createJobInstance(
              JobInstanceStatus.IN_PROGRESS, LocalDateTime.now().minusDays(LOOKBACK_DAYS + 2));

      when(queueRecordRepository.updateStatusByJobInstanceIdAndStatus(
          eq(1L), eq(QueueRecordStatus.PENDING), eq(QueueRecordStatus.SKIPPED)))
          .thenReturn(10);
      when(jobInstanceRepository.save(any())).thenAnswer(inv -> inv.getArgument(0));

      JobInstanceEntity result = annualRenewalJob.onJobInstanceRecovery(jobInstance, config);

      assertThat(result.getStatus()).isEqualTo(JobInstanceStatus.SKIPPED);
      verify(queueRecordRepository)
          .updateStatusByJobInstanceIdAndStatus(
              1L, QueueRecordStatus.PENDING, QueueRecordStatus.SKIPPED);
    }
  }

