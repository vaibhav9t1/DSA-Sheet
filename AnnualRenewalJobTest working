    config.setEnableJobInstanceIdempotency(false);
    config.setContextData(new HashMap<>());

    PeriodicQueueProcessingJobTypeConfig typeConfig = new PeriodicQueueProcessingJobTypeConfig();
    typeConfig.setBatchSize(BATCH_SIZE);
    typeConfig.setMaxRetries(MAX_RETRIES);
    typeConfig.setRepeatIntervalSeconds(3600);
