      JobInstanceEntity jobInstance = createJobInstance(JobInstanceStatus.IN_PROGRESS,
          LocalDateTime.now());

      List<QueueRecordEntity> pendingRecords = new ArrayList<>();
      // create 3 queue records with context data (so map -> DTO conversion yields real context)
      for (int i = 0; i < 3; i++) {
        QueueRecordEntity e = createQueueRecord(1000L + i, QueueRecordStatus.PENDING, 0);
