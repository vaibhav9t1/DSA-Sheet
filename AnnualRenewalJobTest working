    @Test
    void runJobInstance_initializesPendingJobCorrectly() {
      // given
      JobConfig config = createJobConfig();

      JobInstanceEntity jobInstance = createJobInstance(
          JobInstanceStatus.PENDING, LocalDateTime.now()
      );

      // mock job instance save → assign ID
      when(jobInstanceRepository.save(any())).thenAnswer(inv -> inv.getArgument(0));

      // mock eligible queue records returned by fetchEligibleQueueRecords()
      QueueRecordPayloadDto<AnnualRenewalQueueRecordContextDto> payload =
          createQueueRecordPayload(DEFAULT_ACCOUNT_NUMBER, TODAY.plusDays(30));

      when(annualRenewalMapper.mapToQueueRecordPayloadDto(any(), any(), any()))
          .thenReturn(payload);

      // mock periodic fetch of eligible records
      when(ratePromoRepository.findEligibleAnnualPlans())
          .thenReturn(List.of(createRatePromo(DEFAULT_ITEM_CODE)));

      when(didBillingItemRepository.findByItemCodeInAndRenewalDateWithinReminderPeriod(
          anyList(), eq(NOTIF_DAYS), eq(TODAY)))
          .thenReturn(List.of(createActiveBillingItemForAccount(DEFAULT_ACCOUNT_NUMBER)));

      when(saveTerminateTaskRepository.findByAcctNbrAndTaskStatusCdInAndTaskTypeCd(
          any(), anyList(), anyString()))
          .thenReturn(Collections.emptyList());

      // ensure mapper reconstructs DTOs
      when(periodicMapper.mapToJobInstContextData(any(), any()))
          .thenReturn(createContextData());

      // Process queueRecord mapping
      when(periodicMapper.mapToQueueRecordEntities(anyList(), anyLong(), anyInt(), any()))
          .thenAnswer(inv -> {
            List<QueueRecordPayloadDto<?>> payloads = inv.getArgument(0);
            List<QueueRecordEntity> entities = new ArrayList<>();
            for (QueueRecordPayloadDto<?> p : payloads) {
              QueueRecordEntity e = new QueueRecordEntity();
              e.setId(500L);
              e.setBusinessIdentifier(p.getBusinessIdentifier());
              e.setJobInstanceId(jobInstance.getId());
              e.setStatus(QueueRecordStatus.PENDING);
              entities.add(e);
            }
            return entities;
          });

      // --- Fix: Provide valid context to jobInstance ---
      AnnualRenewalJobContextDataDto context = createContextData();
      context.setReminderCalStartDate(TODAY);
      context.setReminderCalEndDate(TODAY);

      Map<String, Object> ctxMap = objectMapper.convertValue(context, Map.class);
      jobInstance.setContextData(ctxMap);

      when(periodicMapper.mapToJobInstContextData(any(), any()))
          .thenReturn(context);

      // when
      annualRenewalJob.runJobInstance(jobInstance, config);

      // then
      // verify transaction was executed
      verify(transactionTemplate).execute(any());

      // verify new queue records were persisted
      verify(queueRecordRepository).saveAll(anyList());

      // verify job instance transitioned to IN_PROGRESS
      assertThat(jobInstance.getStatus()).isEqualTo(JobInstanceStatus.IN_PROGRESS);

      // verify jobInstanceRepository.save called to persist transition
      verify(jobInstanceRepository, atLeastOnce()).save(jobInstance);
    }
  }

