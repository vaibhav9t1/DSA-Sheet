  // --------------------- Lifecycle ---------------------
  @BeforeEach
  void setUpServiceAndMocks() {
    // create and configure ObjectMapper with JavaTimeModule so LocalDate conversions work
    objectMapper = new ObjectMapper();
    objectMapper.registerModule(new JavaTimeModule());
    objectMapper.disable(SerializationFeature.WRITE_DATES_AS_TIMESTAMPS);

    // initialize service under test (always create once per test)
    annualRenewalJob =
        new AnnualRenewalJob(
            ratePromoRepository,
            didBillingItemRepository,
            saveTerminateTaskRepository,
            accountRepository,
            accountUserRepository,
            didNumberRepository,
            accountUserAddressRepository,
            emailServiceClient,
            annualRenewalMapper);

    // inject the superclass' autowired fields using ReflectionTestUtils
    ReflectionTestUtils.setField(annualRenewalJob, "jobInstanceRepository", jobInstanceRepository);
    ReflectionTestUtils.setField(annualRenewalJob, "queueRecordRepository", queueRecordRepository);
    ReflectionTestUtils.setField(annualRenewalJob, "periodicQueueProcessingJobMapper",
        periodicMapper);
    ReflectionTestUtils.setField(annualRenewalJob, "transactionTemplate", transactionTemplate);

    // make transactionTemplate.execute call the callback
    when(transactionTemplate.execute(any()))
        .thenAnswer(
            invocation -> {
              TransactionCallback<Object> callback = invocation.getArgument(0);
              return callback.doInTransaction(null);
            });

    // === periodicMapper behavior stubbing ===
    // 1) always return a non-null job context DTO so job init & recovery logic won't NPE
    AnnualRenewalJobContextDataDto defaultJobContext = createContextData();
    // ensure lookBackDays is set (isUsed in staleness / date math)
    defaultJobContext.setLookBackDays(LOOKBACK_DAYS);
    when(periodicMapper.mapToJobInstContextData(any(), eq(AnnualRenewalJobContextDataDto.class)))
        .thenReturn(defaultJobContext);

    // 2) map job context DTO back to map (used when persisting job instance in init path)
    when(periodicMapper.mapJobInstContextDataToMap(any()))
        .thenAnswer(inv -> objectMapper.convertValue(inv.getArgument(0), Map.class));

    // 3) mapToJobInstanceEntity - give a basic JobInstanceEntity
    when(periodicMapper.mapToJobInstanceEntity(any(), any(), any(), anyInt(), any()))
        .thenAnswer(inv -> createJobInstance(JobInstanceStatus.PENDING, LocalDateTime.now()));

    // 4) reconstruct QueueRecordContext DTOs from Map using objectMapper (handles LocalDate)
    when(periodicMapper.mapToQueueRecordContextData(anyMap(),
        eq(AnnualRenewalQueueRecordContextDto.class)))
        .thenAnswer(inv -> objectMapper.convertValue(inv.getArgument(0),
            AnnualRenewalQueueRecordContextDto.class));

    // 5) mapToQueueRecordEntities: create QueueRecordEntity instances from payloads
    when(periodicMapper.mapToQueueRecordEntities(anyList(), anyLong(), anyInt(), any()))
        .thenAnswer(
            inv -> {
              @SuppressWarnings("unchecked")
              List<QueueRecordPayloadDto<AnnualRenewalQueueRecordContextDto>> payloads =
                  inv.getArgument(0);
              long jobInstId = inv.getArgument(1);
              int retryCount = inv.getArgument(2);
              QueueRecordStatus status = inv.getArgument(3);

              List<QueueRecordEntity> entities = new ArrayList<>();
              for (QueueRecordPayloadDto<?> payload : payloads) {
                QueueRecordEntity e = new QueueRecordEntity();
                e.setId(payload.getId());
                e.setJobInstanceId(jobInstId);
                e.setBusinessIdentifier(payload.getBusinessIdentifier());
                e.setRetryCount(retryCount);
                e.setStatus(status);
                // convert context DTO -> Map for storage
                Map<String, Object> ctxMap = objectMapper.convertValue(payload.getContextData(),
                    Map.class);
                e.setContextData(ctxMap);
                entities.add(e);
              }
              return entities;
            });

    // Mark some repository stubs lenient to avoid UnnecessaryStubbing in tests that don't use them
    lenient().when(accountUserRepository.findUserNameAndEmailAddressByAccountNumber(any()))
        .thenReturn(Optional.of(createAccountUser(DEFAULT_EMAIL)));
    lenient().when(didNumberRepository.findPhoneNumberByDidNumberId(any()))
        .thenReturn(Optional.of(createDidNumber()));
    lenient().when(ratePromoRepository.findPlanPriceByItemCode(any()))
        .thenReturn(Optional.of(createRatePromo(DEFAULT_ITEM_CODE)));
    lenient().when(accountRepository.findPartnerIdByAccountNumber(any()))
        .thenReturn(Optional.of(createAccount()));
    lenient().when(accountUserAddressRepository.findStateProvinceByAccountNumber(any()))
        .thenReturn(Optional.of(createAddress()));
  }

