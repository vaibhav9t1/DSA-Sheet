  @ParameterizedTest
  @CsvSource({
      "0, PENDING, false",
      "1, PENDING, false",
      "2, FAILED, true",
      "3, FAILED, true",
  })
  void testQueueRecordRetryBehavior(int currentRetryCount, String expectedStatusStr) {
    // Given
    QueueRecordStatus expectedStatus = QueueRecordStatus.valueOf(expectedStatusStr);
    QueueRecordEntity queueRecord = createQueueRecordEntity(QUEUE_RECORD_ID, JOB_INSTANCE_ID);
    queueRecord.setRetryCount(currentRetryCount);

    String businessIdentifier = JOB_NAME + BUSINESS_IDENTIFIER_DELIMITER + currentDate;
    JobInstanceEntity jobInstance = createJobInstanceEntity(
        JOB_INSTANCE_ID, businessIdentifier, JobInstanceStatus.IN_PROGRESS);
    jobInstance.setContextData(createContextDataMap());

    when(queueRecordRepository.findByJobInstanceIdAndStatus(
        eq(JOB_INSTANCE_ID), eq(QueueRecordStatus.PENDING), any(PageRequest.class)))
        .thenReturn(List.of(queueRecord));
    when(accountUserRepository.findUserNameAndEmailAddressByAccountNumber(ACCOUNT_NUMBER))
        .thenThrow(new RuntimeException("Email processing failed"));
    when(queueRecordRepository.save(any(QueueRecordEntity.class)))
        .thenAnswer(invocation -> invocation.getArgument(0));

    // When
    annualRenewalJob.runJobInstance(jobInstance, jobConfig);

    // Then - use verify with proper argument capture
    verify(queueRecordRepository).save(argThat(entity ->
        entity.getId().equals(QUEUE_RECORD_ID)
            && entity.getStatus() == expectedStatus
            && entity.getRetryCount() == currentRetryCount + 1
            && entity.getResultContextData() != null
            && entity.getResultContextData().get("failure_reason") != null
    ));
  }

