    lenient().when(didNumberRepository.findPhoneNumberByDidNumberId(DID_NUMBER_ID))
        .thenReturn(Optional.of(createDidNumberEntity()));
    lenient().when(ratePromoRepository.findPlanPriceByItemCode(ITEM_CODE))
