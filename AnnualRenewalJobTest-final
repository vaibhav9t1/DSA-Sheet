    if (hasPartnerId) {
      lenient().when(accountRepository.findPartnerIdByAccountNumber(ACCOUNT_NUMBER))
          .thenReturn(Optional.of(createAccountEntity()));
    } else {
      lenient().when(accountRepository.findPartnerIdByAccountNumber(ACCOUNT_NUMBER))
          .thenReturn(Optional.empty());
    }

    lenient().when(accountUserAddressRepository.findStateProvinceByAccountNumber(ACCOUNT_NUMBER))
        .thenReturn(Optional.of(createAccountUserAddressEntity()));

    // When & Then
    EmailPlaceholderDataNotFoundException exception = assertThrows(
        EmailPlaceholderDataNotFoundException.class,
        () -> annualRenewalJob.processQueueRecord(
            JOB_INSTANCE_ID, JOB_NAME + BUSINESS_IDENTIFIER_DELIMITER + currentDate,
            jobContextData, queueRecordPayload));

    assertTrue(exception.getMessage().toLowerCase().contains(expectedErrorField.toLowerCase()));
  }

