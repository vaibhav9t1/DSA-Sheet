  @Test
  void testInitJobInstance_createsJobInstanceWithCorrectBusinessIdentifier() {
    // Given
    String expectedBusinessIdentifier = JOB_NAME + BUSINESS_IDENTIFIER_DELIMITER
        + currentDate.format(DateTimeFormatter.ISO_LOCAL_DATE);

    when(jobInstanceRepository.findTopByJobNameOrderByCreateDateDesc(JOB_NAME))
        .thenReturn(Optional.empty());
    when(jobInstanceRepository.save(any(JobInstanceEntity.class)))
        .thenAnswer(invocation -> {
          JobInstanceEntity entity = invocation.getArgument(0);
          entity.setId(JOB_INSTANCE_ID);
          return entity;
        });

    // When
    Optional<JobInstanceEntity> result = annualRenewalJob.initJobInstance(jobConfig);

    // Then
    assertTrue(result.isPresent());
    JobInstanceEntity savedEntity = result.get();
    assertEquals(expectedBusinessIdentifier, savedEntity.getBusinessIdentifier());
    assertEquals(JOB_NAME, savedEntity.getJobName());
    assertEquals(JOB_TYPE, savedEntity.getJobType());
    assertEquals(JobInstanceStatus.PENDING, savedEntity.getStatus());

    Map<String, Object> contextData = savedEntity.getContextData();
    assertNotNull(contextData);
    assertNotNull(contextData.get("reminderCalStartDate"));
    assertNotNull(contextData.get("reminderCalEndDate"));

    verify(jobInstanceRepository).save(any(JobInstanceEntity.class));
  }

  @ParameterizedTest
  @ValueSource(booleans = {true, false})
  void testInitJobInstance_respectsIdempotencyConfiguration(boolean idempotencyEnabled) {
    // Given
    JobConfig testJobConfig = createJobConfig(idempotencyEnabled);
    String businessIdentifier = JOB_NAME + BUSINESS_IDENTIFIER_DELIMITER
        + currentDate.format(DateTimeFormatter.ISO_LOCAL_DATE);

    when(jobInstanceRepository.findTopByJobNameOrderByCreateDateDesc(JOB_NAME))
        .thenReturn(Optional.empty());

    if (idempotencyEnabled) {
      JobInstanceEntity existingJobInstance = createJobInstanceEntity(
          JOB_INSTANCE_ID, businessIdentifier, JobInstanceStatus.PENDING);
      when(jobInstanceRepository.findByJobNameAndBusinessIdentifier(JOB_NAME, businessIdentifier))
          .thenReturn(List.of(existingJobInstance));
    }

    lenient().when(jobInstanceRepository.save(any(JobInstanceEntity.class)))
        .thenAnswer(invocation -> {
          JobInstanceEntity entity = invocation.getArgument(0);
          entity.setId(JOB_INSTANCE_ID + 1);
          return entity;
        });

    // When
    Optional<JobInstanceEntity> result = annualRenewalJob.initJobInstance(testJobConfig);

    // Then
    if (idempotencyEnabled) {
      assertFalse(result.isPresent(), "Should skip duplicate when idempotency is enabled");
      verify(jobInstanceRepository, never()).save(any());
    } else {
      assertTrue(result.isPresent(), "Should create new instance when idempotency is disabled");
      verify(jobInstanceRepository, never()).findByJobNameAndBusinessIdentifier(anyString(),
          anyString());
      verify(jobInstanceRepository).save(any());
    }
  }

