  @ParameterizedTest
  @MethodSource("provideJobStalenessScenarios")
  void testOnJobInstanceRecovery_evaluatesStaleness(
      int daysAgo, boolean expectedStale, String scenarioDescription) {
    // Given
    LocalDateTime jobCreateDate = BASE_TEST_DATE.minusDays(daysAgo).atStartOfDay();
    String businessIdentifier =
        JOB_NAME + BUSINESS_IDENTIFIER_DELIMITER + jobCreateDate.toLocalDate();
    JobInstanceEntity jobInstance = createJobInstanceEntity(
        JOB_INSTANCE_ID, businessIdentifier, JobInstanceStatus.IN_PROGRESS);
    jobInstance.setCreateDate(jobCreateDate);
    jobInstance.setContextData(createContextDataMap());

    lenient().when(queueRecordRepository.updateStatusByJobInstanceIdAndStatus(
        anyLong(), any(), any())).thenReturn(5);
    lenient().when(jobInstanceRepository.save(any(JobInstanceEntity.class)))
        .thenAnswer(invocation -> invocation.getArgument(0));

    // When
    JobInstanceEntity result = annualRenewalJob.onJobInstanceRecovery(jobInstance, jobConfig);

    // Then
    if (expectedStale) {
      assertEquals(JobInstanceStatus.SKIPPED, result.getStatus(), scenarioDescription);
      verify(queueRecordRepository).updateStatusByJobInstanceIdAndStatus(
          eq(JOB_INSTANCE_ID), eq(QueueRecordStatus.PENDING), eq(QueueRecordStatus.SKIPPED));
    } else {
      assertEquals(JobInstanceStatus.IN_PROGRESS, result.getStatus(), scenarioDescription);
      verify(queueRecordRepository, never()).updateStatusByJobInstanceIdAndStatus(anyLong(), any(),
          any());
    }
  }

