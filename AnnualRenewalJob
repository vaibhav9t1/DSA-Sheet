/**
 * Job handler for processing annual renewal reminder notifications.
 * This class integrates the business logic of the old AnnualRenewalService
 * into the new generic job framework.
 */
@Slf4j
@Component
public class AnnualRenewalJob extends PeriodicQueueProcessingJobType<AnnualRenewalJobMetadataDto> {

  private static final List<String> DISCONNECT_TASK_STATUS_CODES = List.of("FDPES", "FDP");
  private static final String DISCONNECT_TASK_TYPE_CODE = "ACCT";
  private static final int MONTHS_IN_YEAR = 12;

  private final RatePromoRepository ratePromoRepository;
  private final BillingRepository billingRepository;
  private final SaveTerminateTaskRepository saveTerminateTaskRepository;
  private final AccountRepository accountRepository;
  private final AccountUserRepository accountUserRepository;
  private final DidNumberRepository didNumberRepository;
  private final UnifiedServicesClient unifiedServicesClient;

  /**
   * AnnualRenewalJob Constructor.
   */
  public AnnualRenewalJob(JobInstanceRepository jobInstanceRepository,
                          RatePromoRepository ratePromoRepository,
                          BillingRepository billingRepository,
                          SaveTerminateTaskRepository saveTerminateTaskRepository,
                          AccountRepository accountRepository,
                          AccountUserRepository accountUserRepository,
                          DidNumberRepository didNumberRepository,
                          UnifiedServicesClient unifiedServicesClient,
                          ObjectMapper objectMapper) {
    this.jobInstanceRepository = jobInstanceRepository;
    this.ratePromoRepository = ratePromoRepository;
    this.billingRepository = billingRepository;
    this.saveTerminateTaskRepository = saveTerminateTaskRepository;
    this.accountRepository = accountRepository;
    this.accountUserRepository = accountUserRepository;
    this.didNumberRepository = didNumberRepository;
    this.unifiedServicesClient = unifiedServicesClient;
    this.objectMapper = objectMapper;
  }

  @Override
  protected AnnualRenewalJobMetadataDto getJobMetadata(JobConfig jobConfig) {
    AnnualRenewalJobMetadataDto dto = objectMapper.convertValue(
        jobConfig.getContextData(),
        AnnualRenewalJobMetadataDto.class
    );

    log.info("Loaded job metadata: {}", dto);
    return dto;
  }

  @Override
  protected void enrichJobMetadata(AnnualRenewalJobMetadataDto jobMetadata) {
    Optional<JobInstance> lastJobOpt = jobInstanceRepository
        .findTopByJobNameOrderByCreateDateDesc("ANNUAL_RENEWAL");

    LocalDateTime lastJobCreatedAt = lastJobOpt.map(JobInstance::getCreateDate).orElse(null);

    LocalDate renCalStartDate = getNextEligibleJobDate(jobMetadata, lastJobCreatedAt);
    LocalDate today = LocalDate.now();

    if (renCalStartDate.isAfter(today)) {
      renCalStartDate = today;
    }

    jobMetadata.setRenewalCalStartDate(renCalStartDate);
    jobMetadata.setRenewalCalEndDate(today);
    log.info("Enriched job metadata. Processing renewals from {} to {}", renCalStartDate, today);
  }

  private LocalDate getNextEligibleJobDate(AnnualRenewalJobMetadataDto jobMetadataDto, LocalDateTime lastJobCreatedAt) {
    LocalDate today = LocalDate.now();
    LocalDate cutoffDate = today.minusDays(jobMetadataDto.getLookbackDays());

    if (lastJobCreatedAt == null) {
      return today;
    }

    LocalDate lastJobDate = lastJobCreatedAt.toLocalDate();
    return lastJobDate.isBefore(cutoffDate) ? cutoffDate : lastJobDate.plusDays(1);
  }


  @Override
  protected List<QueueRecordPayloadDto> fetchEligibleRecords(AnnualRenewalJobMetadataDto jobMetadata) {
    log.info("Fetching eligible renewals between {} and {}.",
        jobMetadata.getRenewalCalStartDate(), jobMetadata.getRenewalCalEndDate());

    List<String> eligibleItemCodes = getEligibleAnnualPlanItemCodes();
    if (eligibleItemCodes.isEmpty()) {
      log.info("No eligible annual item codes found. Skipping record fetching.");
      return new ArrayList<>();
    }

    List<DidBillingItemEntity> billingItems = fetchBillingItemsForDateRange(
        jobMetadata.getRenewalCalStartDate(),
        jobMetadata.getRenewalCalEndDate(),
        eligibleItemCodes,
        jobMetadata.getNotifDays());

    log.info("Found {} potentially eligible billing items for notification.", billingItems.size());
    return buildEligibleQueueRecordEntries(billingItems, jobMetadata.getRenewalCalEndDate());
  }

