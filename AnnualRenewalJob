  @Override
  protected Map<String, Object> processQueueRecord(QueueRecordContextDto context) {
    Map<String, Object> metadata = context.getMetadata();
    Long accountNumber = ((Number) metadata.get("accountNumber")).longValue();
    UUID businessIdentifier = (UUID) metadata.get("businessIdentifier");
    log.debug("Processing queue record ID {} for account {} and businessIdentifier {}", context.getId(), accountNumber, businessIdentifier);

    Map<String, Object> resultMap = new HashMap<>();

    try {
      EmailPlaceholderDto emailData = fetchPreparedEmailPlaceholderData(metadata);
      Long emailQueueId = unifiedServicesClient.sendAnnualRenewalReminderEmail(emailData);
      log.info("Successfully dispatched renewal email for account {}.", accountNumber);
      resultMap.put("emailQueueId", emailQueueId);
      return resultMap;
    } catch (Exception ex) {
      log.error("Error processing queue record for account {}: {}", accountNumber, ex.getMessage(), ex);
      throw new RuntimeException("Failed to process renewal email for account " + accountNumber, ex);
    }
  }

  @Override
  protected Class<AnnualRenewalJobMetadataDto> getJobMetadataDtoType() {
    return AnnualRenewalJobMetadataDto.class;
  }

  private List<QueueRecordPayloadDto> buildEligibleQueueRecordEntries(List<DidBillingItemEntity> billingItems, LocalDate processingDate) {
    return billingItems.stream()
        .filter(item -> !(hasDidBillingPlanEndedBeforeRenewalDate(item.getDateEnd(), processingDate)
            || isScheduledForFutureDisconnect(item.getAccountNumber())))
        .map(item -> {
          QueueRecordPayloadDto record = new QueueRecordPayloadDto();
          record.setMetadata(buildQueueRecordMetadata(item, processingDate));
          return record;
        })
        .collect(Collectors.toList());
  }

  private Map<String, Object> buildQueueRecordMetadata(DidBillingItemEntity item, LocalDate today) {
    Map<String, Object> metadata = new HashMap<>();
    LocalDate renewalDate = item.getDateStart().plusMonths(MONTHS_IN_YEAR);
    int daysToRenewal = (int) ChronoUnit.DAYS.between(today, renewalDate);

    metadata.put("accountNumber", item.getAccountNumber());
    metadata.put("didNumberId", item.getDidNumberId());
    metadata.put("itemCode", item.getServiceItemCode());
    metadata.put("didBillingSeqId", item.getSequenceId());
    metadata.put("renewalPeriod", daysToRenewal);
    metadata.put("renewalDate", renewalDate.atStartOfDay().toString());
    return metadata;
  }

  private EmailPlaceholderDto fetchPreparedEmailPlaceholderData(Map<String, Object> metadata) {
    Long accountNumber = ((Number) metadata.get("accountNumber")).longValue();
    Long didNumberId = ((Number) metadata.get("didNumberId")).longValue();
    String itemCode = (String) metadata.get("itemCode");
    LocalDateTime renewalDate = LocalDateTime.parse((String) metadata.get("renewalDate"));

    AccountUserEntity accountUser = getAccountUserData(accountNumber);
    String phone = getPhoneNumber(didNumberId);
    BigDecimal renewalAmount = getPlanPrice(itemCode);
    String partnerId = getPartnerId(accountNumber);

    return EmailPlaceholderDto.builder()
        .accountUser(accountUser)
        .phoneNumber(phone)
        .renewalDate(renewalDate)
        .renewalAmount(renewalAmount)
        .partnerId(partnerId)
        .accountNumber(accountNumber)
        .build();
  }

  private List<String> getEligibleAnnualPlanItemCodes() {
    return ratePromoRepository.findEligibleAnnualPlans().stream()
        .map(RatePromoEntity::getItemCode)
        .collect(Collectors.toList());
  }

  private List<DidBillingItemEntity> fetchBillingItemsForDateRange(
      LocalDate startDate, LocalDate endDate, List<String> eligibleItemCodes, List<Integer> renewalPeriods) {
    List<DidBillingItemEntity> allItems = new ArrayList<>();
    LocalDate currentDate = startDate;
    while (!currentDate.isAfter(endDate)) {
      log.info("Querying this.. {}", renewalPeriods);
      List<DidBillingItemEntity> itemsForDate = billingRepository.findByItemCodeInAndRenewalDateWithinReminderPeriod(
          eligibleItemCodes, renewalPeriods, currentDate);
      allItems.addAll(itemsForDate);
      currentDate = currentDate.plusDays(1);
    }
    return allItems;
  }

  private boolean isScheduledForFutureDisconnect(Long accountNumber) {
    return !saveTerminateTaskRepository
        .findByAcctNbrAndTaskStatusCdInAndTaskTypeCd(accountNumber, DISCONNECT_TASK_STATUS_CODES, DISCONNECT_TASK_TYPE_CODE)
        .isEmpty();
  }

  private boolean hasDidBillingPlanEndedBeforeRenewalDate(LocalDate accountEndDate, LocalDate processingDate) {
    return accountEndDate != null && !accountEndDate.isAfter(processingDate);
  }

  private AccountUserEntity getAccountUserData(Long accountNumber) {
    return accountUserRepository.findUserNameAndEmailAddressByAccountNumber(accountNumber)
        .orElseThrow(() -> new EmailPlaceholderDataNotFoundException("User data not found for account: " + accountNumber));
  }

  private String getPhoneNumber(Long didNumberId) {
    return didNumberRepository.findPhoneNumberByDidNumberId(didNumberId)
        .map(DidNumberEntity::getPhoneNumber)
        .orElseThrow(() -> new EmailPlaceholderDataNotFoundException("Phone number not found for DID ID: " + didNumberId));
  }

  private BigDecimal getPlanPrice(String itemCode) {
    return ratePromoRepository.findPlanPriceByItemCode(itemCode)
        .map(RatePromoEntity::getPrice)
        .orElseThrow(() -> new EmailPlaceholderDataNotFoundException("Plan price not found for item code: " + itemCode));
  }

  private String getPartnerId(Long accountNumber) {
    return accountRepository.findPartnerIdByAccountNumber(accountNumber)
        .map(AccountEntity::getPartnerId)
        .orElseThrow(() -> new EmailPlaceholderDataNotFoundException("Partner ID not found for account: " + accountNumber));
  }
}
