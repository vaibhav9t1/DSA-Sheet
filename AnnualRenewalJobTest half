  // --------------------- Factory Methods ---------------------
  private static JobConfig createJobConfig(boolean enableJobInstanceIdempotency,
      boolean enableQueueRecordIdempotency) {
    JobConfig config = new JobConfig();
    config.setName(JOB_NAME);
    config.setType(JOB_TYPE);
    config.setEnableJobInstanceIdempotency(enableJobInstanceIdempotency);

    PeriodicQueueProcessingJobTypeConfig periodicConfig =
        new PeriodicQueueProcessingJobTypeConfig();
    periodicConfig.setBatchSize(BATCH_SIZE);
    periodicConfig.setMaxRetries(MAX_RETRIES);
    periodicConfig.setRepeatIntervalSeconds(7200);
    periodicConfig.setEnableQueueRecordIdempotency(enableQueueRecordIdempotency);
    config.setPeriodicQueueProcessingJobTypeConfig(periodicConfig);

    Map<String, Object> contextData = new HashMap<>();
    contextData.put("notif-days", NOTIF_DAYS);
    contextData.put("lookback-days", LOOKBACK_DAYS);
    contextData.put("email-api-vg-mailing-name", VG_MAILING_NAME);
    config.setContextData(contextData);

    return config;
  }

  private static JobInstanceEntity createJobInstance(Long id, JobInstanceStatus status,
      LocalDateTime createDate) {
    JobInstanceEntity entity = new JobInstanceEntity();
    entity.setId(id);
    entity.setJobName(JOB_NAME);
    entity.setJobType(JOB_TYPE);
    entity.setStatus(status);
    entity.setBusinessIdentifier(JOB_NAME + "||" + TODAY);
    entity.setCreateDate(createDate);
    entity.setContextData(new HashMap<>());
    return entity;
  }

  private static DidBillingItemEntity createBillingItem(Long accountNumber, LocalDate dateStart,
      LocalDate dateEnd) {
    DidBillingItemEntity entity = new DidBillingItemEntity();
    entity.setAccountNumber(accountNumber);
    entity.setDidNumberId(DEFAULT_DID_NUMBER_ID);
    entity.setServiceItemCode(DEFAULT_ITEM_CODE);
    entity.setDateStart(dateStart);
    entity.setDateEnd(dateEnd);
    entity.setSequenceId(1000L);
    return entity;
  }

  private static List<DidBillingItemEntity> buildBillingItemsWithExpiredAndActive() {
    List<DidBillingItemEntity> dataset = new ArrayList<>();
    for (int i = 0; i < TOTAL_BILLING_ITEMS; i++) {
      long accountNumber = BASE_ACCOUNT_NUMBER + i;
      if (i < EXPIRED_ITEM_COUNT) {
        dataset.add(createBillingItem(accountNumber, TODAY.minusYears(1), TODAY.minusDays(i + 1)));
      } else {
        dataset.add(createBillingItem(accountNumber, TODAY.minusYears(1), null));
      }
    }
    return dataset;
  }

  private static QueueRecordEntity createQueueRecord(Long id, QueueRecordStatus status,
      int retryCount, Long accountNumber) {
    QueueRecordEntity entity = new QueueRecordEntity();
    entity.setId(id);
    entity.setJobInstanceId(DEFAULT_JOB_INSTANCE_ID);
    entity.setBusinessIdentifier("account-" + accountNumber);
    entity.setStatus(status);
    entity.setRetryCount(retryCount);

    Map<String, Object> contextData = new HashMap<>();
    contextData.put("accountNumber", accountNumber);
    contextData.put("didNumberId", DEFAULT_DID_NUMBER_ID);
    contextData.put("itemCode", DEFAULT_ITEM_CODE);
    contextData.put("renewalDate", TODAY.plusDays(30).toString());
    entity.setContextData(contextData);
    entity.setResultContextData(new HashMap<>());
    return entity;
  }

