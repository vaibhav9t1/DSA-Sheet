  @Nested
  class CompleteJobLifecycleExecution {

    /**
     * BUSINESS USE CASE: Schedule annual renewal job, initialize job instance,
     * fetch eligible billing items, persist queue records, and transition to IN_PROGRESS.
     */
    @Test
    void createsNewJobInstanceAndQueuesEligibleRenewalReminders() {
      JobConfig jobConfig = createJobConfig(false, false);

      // Setup: No previous job exists
      when(jobInstanceRepository.findTopByJobNameOrderByCreateDateDesc(JOB_NAME))
          .thenReturn(Optional.empty());
      when(jobInstanceRepository.save(any())).thenAnswer(inv -> {
        JobInstanceEntity entity = inv.getArgument(0);
        entity.setId(DEFAULT_JOB_INSTANCE_ID);
        return entity;
      });

      // Setup: Eligible billing items exist
      when(ratePromoRepository.findEligibleAnnualPlans())
          .thenReturn(List.of(createRatePromo(DEFAULT_ITEM_CODE)));
      when(didBillingItemRepository.findByItemCodeInAndRenewalDateWithinReminderPeriod(
          anyList(), eq(NOTIF_DAYS), any()))
          .thenReturn(List.of(createBillingItem(DEFAULT_ACCOUNT_NUMBER, TODAY.minusYears(1), null)));
      when(saveTerminateTaskRepository.findByAcctNbrAndTaskStatusCdInAndTaskTypeCd(any(), any(), any()))
          .thenReturn(Collections.emptyList());
      when(annualRenewalMapper.mapToQueueRecordPayloadDto(any(), any(), any()))
          .thenReturn(mock());

      // EXECUTE: Create job instance
      Optional<JobInstanceEntity> jobInstanceOpt = annualRenewalJob.initJobInstance(jobConfig);

      // VERIFY: Job instance created
      assertThat(jobInstanceOpt).isPresent();
      JobInstanceEntity jobInstance = jobInstanceOpt.get();
      assertThat(jobInstance.getStatus()).isEqualTo(JobInstanceStatus.PENDING);
      assertThat(jobInstance.getBusinessIdentifier()).contains(JOB_NAME);
      verify(jobInstanceRepository).save(any(JobInstanceEntity.class));

      // EXECUTE: Run job instance (PENDING → IN_PROGRESS with queue records)
      annualRenewalJob.runJobInstance(jobInstance, jobConfig);

      // VERIFY: Queue records persisted and job transitioned to IN_PROGRESS
      verify(queueRecordRepository).saveAll(anyList());
      ArgumentCaptor<JobInstanceEntity> entityCaptor = ArgumentCaptor.forClass(JobInstanceEntity.class);
      verify(jobInstanceRepository, times(2)).save(entityCaptor.capture());
      assertThat(entityCaptor.getValue().getStatus()).isEqualTo(JobInstanceStatus.IN_PROGRESS);
    }

    /**
     * BUSINESS USE CASE: Job instance idempotency - skip creating duplicate job
     * when same business identifier already exists.
     */
    @Test
    void skipsJobCreationWhenIdempotencyEnabledAndDuplicateExists() {
      JobConfig jobConfig = createJobConfig(true, false);

      JobInstanceEntity existingJob = createJobInstance(DEFAULT_JOB_INSTANCE_ID,
          JobInstanceStatus.PENDING, LocalDateTime.now());
      when(jobInstanceRepository.findByJobNameAndBusinessIdentifier(anyString(), anyString()))
          .thenReturn(List.of(existingJob));

      Optional<JobInstanceEntity> result = annualRenewalJob.initJobInstance(jobConfig);

      assertThat(result).isEmpty();
      verify(jobInstanceRepository, never()).save(any());
    }

    /**
     * BUSINESS USE CASE: Process IN_PROGRESS job - fetch pending queue records in batch,
     * send renewal emails, mark records as SUCCESS, and transition job to SUCCESS when done.
     */
    @Test
    void processesPendingQueueRecordsAndTransitionsToSuccessWhenComplete() {
      JobConfig jobConfig = createJobConfig(false, false);
      JobInstanceEntity jobInstance = createJobInstance(DEFAULT_JOB_INSTANCE_ID,
          JobInstanceStatus.IN_PROGRESS, LocalDateTime.now());

      // Setup: 3 pending queue records
      List<QueueRecordEntity> pendingRecords = List.of(
          createQueueRecord(1L, QueueRecordStatus.PENDING, 0, BASE_ACCOUNT_NUMBER),
          createQueueRecord(2L, QueueRecordStatus.PENDING, 0, BASE_ACCOUNT_NUMBER + 1),
          createQueueRecord(3L, QueueRecordStatus.PENDING, 0, BASE_ACCOUNT_NUMBER + 2)
      );
      when(queueRecordRepository.findByJobInstanceIdAndStatus(
          eq(DEFAULT_JOB_INSTANCE_ID), eq(QueueRecordStatus.PENDING), any(PageRequest.class)))
          .thenReturn(pendingRecords).thenReturn(Collections.emptyList());

      setupSuccessfulEmailDispatchMocks();
      when(jobInstanceRepository.save(any())).thenAnswer(inv -> inv.getArgument(0));

      // EXECUTE: First cycle - process 3 records
      annualRenewalJob.runJobInstance(jobInstance, jobConfig);

      // VERIFY: All 3 emails sent and records marked SUCCESS
      verify(emailServiceClient, times(3)).sendEmail(any(), anyString(), anyString(), anyString());
      ArgumentCaptor<QueueRecordEntity> recordCaptor = ArgumentCaptor.forClass(QueueRecordEntity.class);
      verify(queueRecordRepository, times(3)).save(recordCaptor.capture());
      recordCaptor.getAllValues().forEach(record ->
          assertThat(record.getStatus()).isEqualTo(QueueRecordStatus.SUCCESS)
      );

      // EXECUTE: Second cycle - no pending records, should transition to SUCCESS
      annualRenewalJob.runJobInstance(jobInstance, jobConfig);

      // VERIFY: Job transitioned to SUCCESS
      ArgumentCaptor<JobInstanceEntity> entityCaptor = ArgumentCaptor.forClass(JobInstanceEntity.class);
      verify(jobInstanceRepository, times(2)).save(entityCaptor.capture());
      assertThat(entityCaptor.getValue().getStatus()).isEqualTo(JobInstanceStatus.SUCCESS);
    }
  }

  @Nested
  class EligibleBillingItemsFiltering {

    /**
     * BUSINESS USE CASE: Filter out billing items with expired plans - don't send
     * renewal reminders for accounts whose billing plan already ended.
     */
    @ParameterizedTest
    @ValueSource(ints = {1, 5, 10})
    void filtersExpiredBillingItemsFromEligibleRecords(int expiredCount) {
      JobConfig jobConfig = createJobConfig(false, false);

      List<DidBillingItemEntity> mixedItems = new ArrayList<>();
      for (int i = 0; i < expiredCount; i++) {
        mixedItems.add(createBillingItem(BASE_ACCOUNT_NUMBER + i, TODAY.minusYears(1),
            TODAY.minusDays(1)));
      }
      mixedItems.add(createBillingItem(BASE_ACCOUNT_NUMBER + 100, TODAY.minusYears(1), null));

      when(jobInstanceRepository.findTopByJobNameOrderByCreateDateDesc(JOB_NAME))
          .thenReturn(Optional.empty());
      when(jobInstanceRepository.save(any())).thenAnswer(inv -> {
        JobInstanceEntity entity = inv.getArgument(0);
        entity.setId(DEFAULT_JOB_INSTANCE_ID);
        return entity;
      });
      when(ratePromoRepository.findEligibleAnnualPlans())
          .thenReturn(List.of(createRatePromo(DEFAULT_ITEM_CODE)));
      when(didBillingItemRepository.findByItemCodeInAndRenewalDateWithinReminderPeriod(
          anyList(), eq(NOTIF_DAYS), any()))
          .thenReturn(mixedItems);
      when(saveTerminateTaskRepository.findByAcctNbrAndTaskStatusCdInAndTaskTypeCd(any(), any(), any()))
          .thenReturn(Collections.emptyList());
      when(annualRenewalMapper.mapToQueueRecordPayloadDto(any(), any(), any()))
          .thenReturn(mock());

      Optional<JobInstanceEntity> jobInstanceOpt = annualRenewalJob.initJobInstance(jobConfig);
      annualRenewalJob.runJobInstance(jobInstanceOpt.get(), jobConfig);

      // VERIFY: Only 1 queue record created (expired items filtered out)
      ArgumentCaptor<List<QueueRecordEntity>> listCaptor = ArgumentCaptor.forClass(List.class);
      verify(queueRecordRepository).saveAll(listCaptor.capture());
      assertThat(listCaptor.getValue()).hasSize(1);
    }

    /**
     * BUSINESS USE CASE: Filter out accounts scheduled for disconnect - don't send
     * renewal reminders to accounts that are already marked for termination.
     */
    @Test
    void filtersAccountsScheduledForDisconnectFromEligibleRecords() {
      JobConfig jobConfig = createJobConfig(false, false);

      List<DidBillingItemEntity> billingItems = buildBillingItemsWithExpiredAndActive();

      when(jobInstanceRepository.findTopByJobNameOrderByCreateDateDesc(JOB_NAME))
          .thenReturn(Optional.empty());
      when(jobInstanceRepository.save(any())).thenAnswer(inv -> {
        JobInstanceEntity entity = inv.getArgument(0);
        entity.setId(DEFAULT_JOB_INSTANCE_ID);
        return entity;
      });
      when(ratePromoRepository.findEligibleAnnualPlans())
          .thenReturn(List.of(createRatePromo(DEFAULT_ITEM_CODE)));
      when(didBillingItemRepository.findByItemCodeInAndRenewalDateWithinReminderPeriod(
          anyList(), eq(NOTIF_DAYS), any()))
          .thenReturn(billingItems);
      when(saveTerminateTaskRepository.findByAcctNbrAndTaskStatusCdInAndTaskTypeCd(
          anyLong(), anyList(), anyString()))
          .thenAnswer(invocation -> {
            Long acctNbr = invocation.getArgument(0);
            return DISCONNECT_ACCOUNTS.contains(acctNbr)
                ? List.of(mock(SaveTerminateTaskEntity.class))
                : Collections.emptyList();
          });
      when(annualRenewalMapper.mapToQueueRecordPayloadDto(any(), any(), any()))
          .thenReturn(mock());

      Optional<JobInstanceEntity> jobInstanceOpt = annualRenewalJob.initJobInstance(jobConfig);
      annualRenewalJob.runJobInstance(jobInstanceOpt.get(), jobConfig);

      // VERIFY: Expired items + disconnect accounts filtered out
      int expectedRecords = TOTAL_BILLING_ITEMS - EXPIRED_ITEM_COUNT - DISCONNECT_ACCOUNTS.size();
      ArgumentCaptor<List<QueueRecordEntity>> listCaptor = ArgumentCaptor.forClass(List.class);
      verify(queueRecordRepository).saveAll(listCaptor.capture());
      assertThat(listCaptor.getValue()).hasSize(expectedRecords);
    }

    /**
     * BUSINESS USE CASE: Skip job execution when no eligible annual plans exist.
     */
    @Test
    void skipsQueueRecordCreationWhenNoEligiblePlansExist() {
      JobConfig jobConfig = createJobConfig(false, false);

      when(jobInstanceRepository.findTopByJobNameOrderByCreateDateDesc(JOB_NAME))
          .thenReturn(Optional.empty());
      when(jobInstanceRepository.save(any())).thenAnswer(inv -> {
        JobInstanceEntity entity = inv.getArgument(0);
        entity.setId(DEFAULT_JOB_INSTANCE_ID);
        return entity;
      });
      when(ratePromoRepository.findEligibleAnnualPlans()).thenReturn(Collections.emptyList());

      Optional<JobInstanceEntity> jobInstanceOpt = annualRenewalJob.initJobInstance(jobConfig);
      annualRenewalJob.runJobInstance(jobInstanceOpt.get(), jobConfig);

      verify(didBillingItemRepository, never())
          .findByItemCodeInAndRenewalDateWithinReminderPeriod(any(), any(), any());
      verify(queueRecordRepository, never()).saveAll(anyList());
    }
  }

  @Nested
